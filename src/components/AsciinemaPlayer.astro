---
import playerJs from "asciinema-player/dist/bundle/asciinema-player.min.js?url";
import playerCss from "asciinema-player/dist/bundle/asciinema-player.css?url";

interface Props {
  src: string;
  autoplay?: boolean;
  loop?: boolean;
}
const { src, autoplay = false, loop = false } = Astro.props;
const id = "ap-" + Math.random().toString(36).slice(2, 8);
---

<div class={id}></div>
<link rel="stylesheet" href={playerCss} />
<script is:inline src={playerJs}></script>
<script is:inline define:vars={{ id, src, autoplay, loop }}>
  AsciinemaPlayer.create(src, document.querySelector("." + id), {
    autoPlay: autoplay,
    loop: loop,
  });
</script>
