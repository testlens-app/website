---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import adopters from "../../data/adopters.json";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/adopters/*.svg"
);

function getLogo(logo: string) {
  return logos["../../assets/adopters/" + logo]();
}

interface Adopter {
  name: string;
  url: string;
  logo: string;
}
---

<section class="mt-10 text-center sm:mt-15 sm:mb-15">
  <h3 class="text-dark mb-6 text-center text-3xl font-bold">
    Trusted by leading open source projects
  </h3>
  <div
    class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-4"
  >
    {
      adopters.map((adopter: Adopter) => (
        <a
          href={adopter.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-20 w-40 items-center justify-center rounded-xl bg-white p-4 opacity-80 shadow-sm transition hover:opacity-100 hover:shadow-md"
          title={adopter.name}
        >
          <Image
            src={getLogo(adopter.logo)}
            alt={adopter.name}
            width={140}
            class="h-12 w-auto"
          />
        </a>
      ))
    }
  </div>
</section>
