---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { name: "Contact", href: "/contact" },
  { name: "Terms of Service", href: "/terms" },
  { name: "Privacy Policy", href: "/privacy" },
];
---

<footer class="bg-white">
  <div
    class="footer-copyright text-muted mx-auto max-w-7xl px-4 py-8 text-center text-sm"
  >
    <nav class="mb-4 flex flex-wrap justify-center gap-x-6 gap-y-2">
      {
        footerLinks.map(item => (
          <a href={item.href} title={item.name} class="hover:underline">
            {item.name}
          </a>
        ))
      }
    </nav>
    <span class="font-mono">&copy;</span>
    {currentYear} TestLens. All rights reserved.
  </div>
  <a rel="me" href="https://mastodon.social/@testlens" class="hidden"
    >Mastodon</a
  >
</footer>
